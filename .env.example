# Copy to .env (chmod 600) and fill in. launchd/run-bridge.sh sources it
# before exec'ing the bridge; config.yaml names the broker credentials as
# ${MQTT_USERNAME} / ${MQTT_PASSWORD}.
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password

# Everything below is optional — the bridge runs with just the two broker
# credentials above. Uncomment only if you need to override a default.

# Path to config.yaml, if you don't want to pass -c/--config explicitly or
# run from the project directory. Read by src/findmy_bridge/cli.py.
# FINDMY_CONFIG=/path/to/config.yaml

# Seconds to wait after --once / --clear before disconnecting, so paho-mqtt's
# network thread has time to flush queued QoS-1 messages. Read by cli.py.
# FINDMY_ONCE_DRAIN=4

# Tuning for the findmy-keepawake LaunchAgent (launchd/findmy-keepawake.sh),
# which relaunches Find My when its cache goes stale on a headless machine.
# FINDMY_CHECK_SECONDS=15
# FINDMY_STALE_SECONDS=60
